---
// `content` is a richText field with `wysiwyg: true` in the backend schema, which
// is what sends AposField the rendered markup. Props are flat, with no `with`.
import AposField from '@apostrophecms/apostrophe-astro/components/AposField.astro';
import { getLinkPath, opensInNewTab } from '../utils/link.js';

const { widget } = Astro.props;
---

<div class="widget hero-widget">
  <div class="hero-widget__content">
    {/* `demo-rte` keeps the shared rich text styles the old rich text widget carried. */}
    <AposField doc={widget} name="content" class="demo-rte hero-widget__text" />
  </div>
  {widget.links?.length > 0 && (
    <div class="hero-widget__buttons">
      {widget.links.map((item) => {
        const path = getLinkPath(item);
        const isBlank = opensInNewTab(item.linkTarget);
        const linkClass = `link button ${item.style || ''}`;
        return (
          <a
            class={linkClass}
            href={path}
            target={isBlank ? '_blank' : undefined}
          >{item.linkText}</a>
        );
      })}
    </div>
  )}
</div>
